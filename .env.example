# ── Production (Vercel → Project → Settings → Environment Variables) ──
# GEMINI_API_KEY=your_key_from_aistudio.google.com/apikey     (server-side, used by /api/chat)
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite         (optional; tried in order)
#
# Health check after deploy: open https://<your-site>/api/chat  →  {"ok":true,"configured":true,...}

# ── Local dev only (never used in production builds) ──
VITE_GEMINI_KEY=
